# ==============================================================================
# CloudGuard FinOps Environment Configuration
# ==============================================================================

# Environment mode: development | staging | production
ENVIRONMENT=development

# JWT Authentication (generate a secure random 32+ char key for production)
JWT_SECRET_KEY=cloudguard-development-secret-key-change-in-production-2026

# Database Connections (PostgreSQL Async & Sync)
DATABASE_URL=postgresql+asyncpg://cloudguard_user:cloudguard_password@localhost:5432/cloudguard
SYNC_DATABASE_URL=postgresql://cloudguard_user:cloudguard_password@localhost:5432/cloudguard

# Redis & Celery Message Broker
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# AWS Telemetry Settings
AWS_DEFAULT_REGION=us-east-1
# Set to 'false' in production to query live CloudWatch & Cost Explorer via STS AssumeRole
USE_MOCK_TELEMETRY=true

# GitOps & GitHub Integration
# Option A: Personal Access Token (PAT)
GITHUB_TOKEN=
# Option B: GitHub App Authentication
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PEM=

# Observability (Optional)
SENTRY_DSN=
LOG_LEVEL=INFO
